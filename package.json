  "scripts": {
    "build": "hugo --cleanDestinationDir --gc --logLevel debug --minify --noBuildLock --forceSyncStatic --destination ./docs",
	"serve": "hugo serve --renderToMemory --ignoreCache --disableFastRender --logLevel debug --noHTTPCache --bind 0.0.0.0",
    "servefolder": "hugo serve -M=false --destination ./preview --ignoreCache --disableFastRender --logLevel debug --forceSyncStatic --noHTTPCache --bind 0.0.0.0"
  }
